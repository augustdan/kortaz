# ==============================================================================
# BARBEROS — Variáveis de Ambiente (Exemplo para Desenvolvimento e Produção)
# ==============================================================================

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE (Banco PostgreSQL, Auth, Storage, RLS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-publishable-ou-anon-key
# NUNCA exponha a chave abaixo com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Segredo para assinatura de cookies de sessão HMAC-SHA256
BARBEROS_SESSION_SECRET=troque-por-um-segredo-forte-de-64-caracteres-aleatorios

# ------------------------------------------------------------------------------
# MERCADO PAGO (Pagamentos Pix, Cartão, Checkout e Webhooks)
# ------------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=seu-webhook-secret-mercadopago

# ------------------------------------------------------------------------------
# WHATSAPP BUSINESS API (Meta Cloud API ou Provedor Compatível)
# ------------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_API_TOKEN=EAAxxxxxxxxx

# ------------------------------------------------------------------------------
# RESEND (E-mails Transacionais)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=BarberOS <nao-responda@seudominio.com.br>

# ------------------------------------------------------------------------------
# GOOGLE CALENDAR (Opcional — Sincronização de Agenda)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
